project "ok" version "0.1.0"

target lib {
  kind    = "library"
  sources = ["lib/b.kl"]
}

target app {
  kind    = "binary"
  sources = ["a.kl"]
  deps    = ["lib"]
}

build {
  default = "app"
  backend = native
  out     = ".kinglet/out"
}

fmt {
  indent = 2
  trailing_comma = false
  extensions = "group-using"
}
